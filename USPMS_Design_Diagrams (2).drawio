        <mxCell id="cedge8" value="has snapshots  1 — 0..*" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#5B6777;strokeWidth=2;endArrow=none;strokeColor=#5B6777;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1360" y="770" as="sourcePoint" />
            <mxPoint x="1660" y="950" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c_invariants" value="&lt;b&gt;Domain invariants&lt;/b&gt;&lt;br&gt;1. A parking recommendation must satisfy active permit / temporary credential authorisation before ranking.&lt;br&gt;2. An active permit is bounded by its validity period and status.&lt;br&gt;3. Occupancy values must be within zero and configured capacity; freshness is explicit.&lt;br&gt;4. Active reservations for the same bay/resource cannot overlap." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F9FC;strokeColor=#7E8FA3;fontSize=17;fontColor=#203043;" vertex="1">
          <mxGeometry x="50" y="1270" width="1900" height="130" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
